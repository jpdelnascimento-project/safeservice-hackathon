# ============================================================
# PASSO 1 — Crie uma conta GRÁTIS em https://www.alchemy.com
#   → Clique "Create App"
#   → Chain: Ethereum | Network: Sepolia
#   → Copie a URL que aparece e cole abaixo:
# ============================================================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_KEY_AQUI

# ============================================================
# PASSO 2 — Exporte a chave privada da carteira MetaMask
#   → MetaMask → clique nos 3 pontos → "Detalhes da conta"
#   → "Exportar chave privada" → cole abaixo:
#   ATENÇÃO: Nunca partilhe este ficheiro com ninguém!
# ============================================================
DEPLOYER_PRIVATE_KEY=SUA_CHAVE_PRIVADA_AQUI
